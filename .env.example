POSTGRES_USER=eve
POSTGRES_DB=eve
POSTGRES_PASSWORD=replace-with-a-generated-url-safe-password
# Use the same generated password here when running the API locally.
DATABASE_URL=postgresql+psycopg://eve:replace-with-a-generated-url-safe-password@localhost:5432/eve
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEBHOOK_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=5
PAYMENT_RATE_LIMIT=20
WEBHOOK_RATE_LIMIT=120
# Compose host ports; change these if another local application uses the defaults.
API_PORT=8000
POSTGRES_PORT=5432
